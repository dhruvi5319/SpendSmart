{
  "name": "spendsmart",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@spendsmart/web",
    "dev:api": "cd apps/api && source venv/bin/activate && python -m uvicorn app.main:app --reload --port 8000",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "cd apps/api && alembic upgrade head",
    "db:generate": "cd apps/api && alembic revision --autogenerate -m",
    "db:seed": "npx tsx apps/web/src/db/seed.ts",
    "db:seed:feb": "npx tsx apps/web/src/db/seed-feb.ts",
    "db:seed:march": "npx tsx apps/web/src/db/seed-march.ts"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
